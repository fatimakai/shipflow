generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("user_status")
}

enum MembershipRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")
  VIEWER @map("viewer")

  @@map("membership_role")
}

enum InvitationStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REVOKED  @map("revoked")
  EXPIRED  @map("expired")

  @@map("invitation_status")
}

enum SessionRevocationReason {
  ROTATED        @map("rotated")
  LOGOUT         @map("logout")
  LOGOUT_ALL     @map("logout_all")
  REUSE_DETECTED @map("reuse_detected")
  ADMINISTRATIVE @map("administrative")

  @@map("session_revocation_reason")
}

enum TwoFactorChallengePurpose {
  LOGIN @map("login")

  @@map("two_factor_challenge_purpose")
}

enum EmailCategory {
  EMAIL_VERIFICATION      @map("email_verification")
  PASSWORD_RESET          @map("password_reset")
  ORGANIZATION_INVITATION @map("organization_invitation")
  SECURITY_NOTICE         @map("security_notice")

  @@map("email_category")
}

enum EmailDeliveryStatus {
  PENDING    @map("pending")
  SENDING    @map("sending")
  SENT       @map("sent")
  DELIVERED  @map("delivered")
  FAILED     @map("failed")
  BOUNCED    @map("bounced")
  COMPLAINED @map("complained")
  SUPPRESSED @map("suppressed")

  @@map("email_delivery_status")
}

enum PlanCode {
  FREE @map("free")
  PRO  @map("pro")

  @@map("plan_code")
}

enum BillingInterval {
  MONTHLY @map("monthly")
  ANNUAL  @map("annual")

  @@map("billing_interval")
}

enum SubscriptionStatus {
  INCOMPLETE         @map("incomplete")
  INCOMPLETE_EXPIRED @map("incomplete_expired")
  TRIALING           @map("trialing")
  ACTIVE             @map("active")
  PAST_DUE           @map("past_due")
  CANCELED           @map("canceled")
  UNPAID             @map("unpaid")
  PAUSED             @map("paused")

  @@map("subscription_status")
}

enum NotificationCategory {
  SECURITY     @map("security")
  ORGANIZATION @map("organization")
  BILLING      @map("billing")

  @@map("notification_category")
}

enum NotificationType {
  PASSWORD_CHANGED                   @map("password_changed")
  ORGANIZATION_INVITATION_ACCEPTED   @map("organization_invitation_accepted")
  ORGANIZATION_ROLE_CHANGED          @map("organization_role_changed")
  ORGANIZATION_MEMBER_REMOVED        @map("organization_member_removed")
  ORGANIZATION_OWNERSHIP_TRANSFERRED @map("organization_ownership_transferred")
  BILLING_TRIAL_STARTED              @map("billing_trial_started")
  BILLING_PAYMENT_FAILED             @map("billing_payment_failed")
  BILLING_GRACE_PERIOD_STARTED       @map("billing_grace_period_started")
  BILLING_CANCELLATION_SCHEDULED     @map("billing_cancellation_scheduled")
  BILLING_SUBSCRIPTION_CANCELED      @map("billing_subscription_canceled")
  BILLING_FULL_REFUND                @map("billing_full_refund")
  BILLING_DISPUTE                    @map("billing_dispute")

  @@map("notification_type")
}

enum FileStatus {
  PENDING  @map("pending")
  SCANNING @map("scanning")
  READY    @map("ready")
  DELETED  @map("deleted")
  REJECTED @map("rejected")
  FAILED   @map("failed")
  PURGED   @map("purged")

  @@map("file_status")
}

enum FileMalwareStatus {
  NOT_REQUIRED @map("not_required")
  PENDING      @map("pending")
  CLEAN        @map("clean")
  INFECTED     @map("infected")
  UNSUPPORTED  @map("unsupported")
  FAILED       @map("failed")

  @@map("file_malware_status")
}

enum FileStorageProvider {
  LOCAL @map("local")
  S3    @map("s3")

  @@map("file_storage_provider")
}

enum AuditActorType {
  ANONYMOUS     @map("anonymous")
  USER          @map("user")
  SYSTEM        @map("system")
  SUPPORT_ADMIN @map("support_admin")

  @@map("audit_actor_type")
}

enum AuditOutcome {
  SUCCESS @map("success")
  FAILURE @map("failure")

  @@map("audit_outcome")
}

enum AuditSeverity {
  INFO     @map("info")
  WARNING  @map("warning")
  CRITICAL @map("critical")

  @@map("audit_severity")
}

model User {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                   String                   @unique(map: "users_email_key") @db.VarChar(320)
  displayName             String?                  @map("display_name") @db.VarChar(100)
  avatarUrl               String?                  @map("avatar_url") @db.Text
  passwordHash            String?                  @map("password_hash") @db.VarChar(255)
  status                  UserStatus               @default(ACTIVE)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt             DateTime?                @map("last_login_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(3)
  oauthAccounts           OAuthAccount[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  memberships             Membership[]
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  acceptedInvitations     Invitation[]             @relation("InvitationAcceptor")
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  uploadedFiles           StoredFile[]             @relation("FileUploader")
  twoFactorCredential     TwoFactorCredential?
  twoFactorChallenges     TwoFactorChallenge[]

  @@index([status], map: "users_status_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(50)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "oauth_accounts_provider_account_key")
  @@index([userId], map: "oauth_accounts_user_id_idx")
  @@map("oauth_accounts")
}

model Session {
  id               String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  tokenHash        String                   @unique(map: "sessions_token_hash_key") @map("token_hash") @db.VarChar(128)
  tokenFamilyId    String                   @default(dbgenerated("uuidv7()")) @map("token_family_id") @db.Uuid
  replacedById     String?                  @unique(map: "sessions_replaced_by_id_key") @map("replaced_by_id") @db.Uuid
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?                @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revocationReason SessionRevocationReason? @map("revocation_reason")
  ipAddress        String?                  @map("ip_address") @db.Inet
  userAgent        String?                  @map("user_agent") @db.VarChar(512)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy       Session?                 @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces         Session?                 @relation("SessionRotation")

  @@index([userId, revokedAt], map: "sessions_user_id_revoked_at_idx")
  @@index([tokenFamilyId], map: "sessions_token_family_id_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@map("sessions")
}

model EmailVerificationToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  email      String    @db.VarChar(320)
  tokenHash  String    @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "email_verification_tokens_user_id_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model TwoFactorCredential {
  id                   String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId               String                @unique(map: "two_factor_credentials_user_id_key") @map("user_id") @db.Uuid
  encryptedSecret      Bytes                 @map("encrypted_secret")
  initializationVector Bytes                 @map("initialization_vector")
  authenticationTag    Bytes                 @map("authentication_tag")
  encryptionKeyVersion Int                   @default(1) @map("encryption_key_version")
  enabledAt            DateTime?             @map("enabled_at") @db.Timestamptz(3)
  lastUsedTimeStep     BigInt?               @map("last_used_time_step")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes          TwoFactorBackupCode[]

  @@index([enabledAt], map: "two_factor_credentials_enabled_at_idx")
  @@map("two_factor_credentials")
}

model TwoFactorBackupCode {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  credentialId String              @map("credential_id") @db.Uuid
  codeHash     String              @unique(map: "two_factor_backup_codes_code_hash_key") @map("code_hash") @db.VarChar(64)
  consumedAt   DateTime?           @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  credential   TwoFactorCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, consumedAt], map: "two_factor_backup_codes_credential_consumed_idx")
  @@map("two_factor_backup_codes")
}

model TwoFactorChallenge {
  id         String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String                    @map("user_id") @db.Uuid
  tokenHash  String                    @unique(map: "two_factor_challenges_token_hash_key") @map("token_hash") @db.VarChar(64)
  purpose    TwoFactorChallengePurpose @default(LOGIN)
  expiresAt  DateTime                  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?                 @map("consumed_at") @db.Timestamptz(3)
  ipAddress  String?                   @map("ip_address") @db.Inet
  userAgent  String?                   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt], map: "two_factor_challenges_user_consumed_idx")
  @@index([expiresAt], map: "two_factor_challenges_expires_at_idx")
  @@map("two_factor_challenges")
}

model Organization {
  id              String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId         String                  @map("owner_id") @db.Uuid
  name            String                  @db.VarChar(120)
  slug            String                  @unique(map: "organizations_slug_key") @db.VarChar(63)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?               @map("deleted_at") @db.Timestamptz(3)
  owner           User                    @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships     Membership[]
  invitations     Invitation[]
  stripeCustomer  StripeCustomer?
  subscription    Subscription?
  checkoutSession BillingCheckoutSession?
  notifications   Notification[]
  files           StoredFile[]

  @@index([ownerId], map: "organizations_owner_id_idx")
  @@index([deletedAt], map: "organizations_deleted_at_idx")
  @@map("organizations")
}

model Membership {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "memberships_organization_id_user_id_key")
  @@index([userId], map: "memberships_user_id_idx")
  @@index([organizationId, role], map: "memberships_organization_id_role_idx")
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  invitedById    String           @map("invited_by_id") @db.Uuid
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  email          String           @db.VarChar(320)
  role           MembershipRole   @default(MEMBER)
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique(map: "invitations_token_hash_key") @map("token_hash") @db.VarChar(128)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy     User?            @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status], map: "invitations_organization_id_status_idx")
  @@index([invitedById], map: "invitations_invited_by_id_idx")
  @@index([acceptedById], map: "invitations_accepted_by_id_idx")
  @@index([expiresAt], map: "invitations_expires_at_idx")
  @@map("invitations")
}

model EmailDelivery {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  category          EmailCategory
  provider          String              @db.VarChar(32)
  providerMessageId String?             @unique(map: "email_deliveries_provider_message_id_key") @map("provider_message_id") @db.VarChar(255)
  recipientEmail    String              @map("recipient_email") @db.VarChar(320)
  idempotencyKey    String              @unique(map: "email_deliveries_idempotency_key_key") @map("idempotency_key") @db.VarChar(256)
  status            EmailDeliveryStatus @default(PENDING)
  attempts          Int                 @default(0)
  lastErrorCode     String?             @map("last_error_code") @db.VarChar(100)
  lastErrorMessage  String?             @map("last_error_message") @db.VarChar(500)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz(3)
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz(3)
  lastEventAt       DateTime?           @map("last_event_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([recipientEmail, createdAt], map: "email_deliveries_recipient_created_at_idx")
  @@index([status, createdAt], map: "email_deliveries_status_created_at_idx")
  @@map("email_deliveries")
}

model EmailWebhookEvent {
  id                String   @id @db.VarChar(255)
  eventType         String   @map("event_type") @db.VarChar(100)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(255)
  eventCreatedAt    DateTime @map("event_created_at") @db.Timestamptz(3)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([providerMessageId], map: "email_webhook_events_provider_message_id_idx")
  @@map("email_webhook_events")
}

model Plan {
  id                String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code              PlanCode       @unique(map: "plans_code_key")
  name              String         @db.VarChar(100)
  description       String         @db.VarChar(500)
  currency          String         @default("usd") @db.VarChar(3)
  monthlyPriceCents Int            @map("monthly_price_cents")
  annualPriceCents  Int            @map("annual_price_cents")
  features          String[]       @default([])
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions     Subscription[]

  @@map("plans")
}

model StripeCustomer {
  id               String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId   String       @unique(map: "stripe_customers_organization_id_key") @map("organization_id") @db.Uuid
  stripeCustomerId String       @unique(map: "stripe_customers_stripe_customer_id_key") @map("stripe_customer_id") @db.VarChar(255)
  trialUsedAt      DateTime?    @map("trial_used_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("stripe_customers")
}

model BillingCheckoutSession {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId  String          @unique(map: "billing_checkout_sessions_organization_id_key") @map("organization_id") @db.Uuid
  requestKey      String          @unique(map: "billing_checkout_sessions_request_key_key") @map("request_key") @db.Uuid
  interval        BillingInterval
  stripeSessionId String?         @unique(map: "billing_checkout_sessions_stripe_session_id_key") @map("stripe_session_id") @db.VarChar(255)
  checkoutUrl     String?         @map("checkout_url") @db.VarChar(2048)
  expiresAt       DateTime        @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "billing_checkout_sessions_expires_at_idx")
  @@map("billing_checkout_sessions")
}

model Subscription {
  id                       String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId           String             @unique(map: "subscriptions_organization_id_key") @map("organization_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  stripeSubscriptionId     String             @unique(map: "subscriptions_stripe_subscription_id_key") @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId            String             @map("stripe_price_id") @db.VarChar(255)
  stripeLatestInvoiceId    String?            @map("stripe_latest_invoice_id") @db.VarChar(255)
  interval                 BillingInterval
  status                   SubscriptionStatus
  automaticTaxEnabled      Boolean            @default(true) @map("automatic_tax_enabled")
  cancelAtPeriodEnd        Boolean            @default(false) @map("cancel_at_period_end")
  currentPeriodStart       DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd         DateTime           @map("current_period_end") @db.Timestamptz(3)
  trialStart               DateTime?          @map("trial_start") @db.Timestamptz(3)
  trialEnd                 DateTime?          @map("trial_end") @db.Timestamptz(3)
  gracePeriodEndsAt        DateTime?          @map("grace_period_ends_at") @db.Timestamptz(3)
  canceledAt               DateTime?          @map("canceled_at") @db.Timestamptz(3)
  endedAt                  DateTime?          @map("ended_at") @db.Timestamptz(3)
  lastStripeEventCreatedAt DateTime           @map("last_stripe_event_created_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId], map: "subscriptions_plan_id_idx")
  @@index([status, gracePeriodEndsAt], map: "subscriptions_status_grace_period_idx")
  @@map("subscriptions")
}

model ProcessedStripeEvent {
  id               String   @id @db.VarChar(255)
  eventType        String   @map("event_type") @db.VarChar(100)
  providerObjectId String?  @map("provider_object_id") @db.VarChar(255)
  eventCreatedAt   DateTime @map("event_created_at") @db.Timestamptz(3)
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@index([providerObjectId], map: "processed_stripe_events_provider_object_id_idx")
  @@map("processed_stripe_events")
}

model Notification {
  id             String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  organizationId String?              @map("organization_id") @db.Uuid
  category       NotificationCategory
  type           NotificationType
  title          String               @db.VarChar(160)
  message        String               @db.VarChar(500)
  actionPath     String?              @map("action_path") @db.VarChar(500)
  metadata       Json                 @default("{}") @db.JsonB
  dedupeKey      String               @map("dedupe_key") @db.VarChar(255)
  readAt         DateTime?            @map("read_at") @db.Timestamptz(3)
  expiresAt      DateTime             @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey], map: "notifications_user_id_dedupe_key_key")
  @@index([userId, createdAt, id], map: "notifications_user_id_created_at_id_idx")
  @@index([userId, readAt, createdAt], map: "notifications_user_id_read_at_created_at_idx")
  @@index([organizationId, userId, createdAt], map: "notifications_organization_id_user_id_created_at_idx")
  @@index([expiresAt], map: "notifications_expires_at_idx")
  @@map("notifications")
}

model NotificationPreference {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String   @unique(map: "notification_preferences_user_id_key") @map("user_id") @db.Uuid
  organizationEnabled Boolean  @default(true) @map("organization_enabled")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model StoredFile {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  uploadedById         String              @map("uploaded_by_id") @db.Uuid
  storageProvider      FileStorageProvider @map("storage_provider")
  objectKey            String              @unique(map: "stored_files_object_key_key") @map("object_key") @db.VarChar(512)
  originalName         String              @map("original_name") @db.VarChar(255)
  declaredMimeType     String              @map("declared_mime_type") @db.VarChar(127)
  detectedMimeType     String?             @map("detected_mime_type") @db.VarChar(127)
  sizeBytes            Int                 @map("size_bytes")
  checksumSha256       String              @map("checksum_sha256") @db.Char(64)
  status               FileStatus          @default(PENDING)
  malwareStatus        FileMalwareStatus   @default(PENDING) @map("malware_status")
  scanAttempts         Int                 @default(0) @map("scan_attempts")
  reservationExpiresAt DateTime            @map("reservation_expires_at") @db.Timestamptz(3)
  uploadedAt           DateTime?           @map("uploaded_at") @db.Timestamptz(3)
  scanCompletedAt      DateTime?           @map("scan_completed_at") @db.Timestamptz(3)
  deletedAt            DateTime?           @map("deleted_at") @db.Timestamptz(3)
  purgeAfter           DateTime?           @map("purge_after") @db.Timestamptz(3)
  purgedAt             DateTime?           @map("purged_at") @db.Timestamptz(3)
  auditExpiresAt       DateTime?           @map("audit_expires_at") @db.Timestamptz(3)
  lastLifecycleError   String?             @map("last_lifecycle_error") @db.VarChar(500)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy           User                @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt], map: "stored_files_organization_status_created_at_idx")
  @@index([organizationId, uploadedById], map: "stored_files_organization_uploader_idx")
  @@index([status, reservationExpiresAt], map: "stored_files_status_reservation_expires_at_idx")
  @@index([status, purgeAfter], map: "stored_files_status_purge_after_idx")
  @@index([auditExpiresAt], map: "stored_files_audit_expires_at_idx")
  @@map("stored_files")
}

model AuditLog {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType      String         @map("event_type") @db.VarChar(100)
  actorType      AuditActorType @map("actor_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  targetType     String?        @map("target_type") @db.VarChar(64)
  targetId       String?        @map("target_id") @db.VarChar(255)
  outcome        AuditOutcome
  severity       AuditSeverity
  reasonCode     String?        @map("reason_code") @db.VarChar(100)
  requestId      String?        @map("request_id") @db.VarChar(128)
  ipAddress      String?        @map("ip_address") @db.Inet
  userAgent      String?        @map("user_agent") @db.VarChar(512)
  metadata       Json           @default("{}") @db.JsonB
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "audit_logs_expires_at_idx")
  @@index([actorUserId, occurredAt], map: "audit_logs_actor_occurred_at_idx")
  @@index([organizationId, occurredAt], map: "audit_logs_organization_occurred_at_idx")
  @@index([eventType, occurredAt], map: "audit_logs_event_type_occurred_at_idx")
  @@map("audit_logs")
}
