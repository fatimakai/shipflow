NODE_ENV=development
PORT=3000
APP_NAME="ShipFlow API"
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_TRUST_PROXY_HOPS=0
HTTP_MAX_REQUESTS_PER_SOCKET=1000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Local PostgreSQL
POSTGRES_DB=shipflow
POSTGRES_USER=shipflow
POSTGRES_PASSWORD=shipflow_local_password
POSTGRES_PORT=5432
DATABASE_URL="postgresql://shipflow:shipflow_local_password@localhost:5432/shipflow?schema=public"
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SLOW_QUERY_MS=500

# Authentication
JWT_ACCESS_SECRET=local-only-jwt-secret-change-me-before-production
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
TWO_FACTOR_ISSUER=ShipFlow
# Development-only key. Generate a unique 32-byte base64 key for every deployment.
TWO_FACTOR_ENCRYPTION_KEY=c2hpcGZsb3ctbG9jYWwtMmZhLWtleS12MS0wMDAwMDA=
TWO_FACTOR_ENCRYPTION_KEY_VERSION=1
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_COOKIE_NAME=shipflow_refresh
AUTH_COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# Transactional email
EMAIL_PROVIDER=log
EMAIL_FROM_NAME=ShipFlow
EMAIL_FROM_ADDRESS=no-reply@mail.example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_SUPPORT_ADDRESS=support@example.com
EMAIL_SMOKE_TEST_RECIPIENT=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Organization billing
BILLING_PROVIDER=stub
BILLING_TRIAL_DAYS=14
BILLING_GRACE_PERIOD_DAYS=7
BILLING_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRODUCT_ID=prod_local_pro
STRIPE_PRO_MONTHLY_PRICE_ID=price_local_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_local_pro_annual
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Private file storage. Production uses R2's S3-compatible API and ClamAV.
FILE_STORAGE_PROVIDER=local
FILE_LOCAL_ROOT=.data/files
FILE_MALWARE_SCAN_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Optional OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback
